{
    "name": "kenny1911/symfony-http-exception",
    "description": "Symfony Bundle for converting PHP exceptions into Symfony HTTP exceptions via attributes and configuration, with support for status codes, messages, headers, and translation.",
    "keywords": ["symfony", "bundle" ,"http", "exception", "convert", "message", "status", "code"],
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Kenny1911",
            "email": "o-muzyka@mail.ru"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "psalm": "./tools/psalm/vendor/bin/psalm --no-cache",
        "phpunit": "phpunit",
        "cs-fix": "./tools/php-cs-fixer/vendor/bin/php-cs-fixer fix",
        "cs-check": "./tools/php-cs-fixer/vendor/bin/php-cs-fixer check",
        "composer-require-checker": "./tools/composer-require-checker/vendor/bin/composer-require-checker check --config-file=composer-require-checker.json",
        "composer-unused": "./tools/composer-unused/vendor/bin/composer-unused",
        "checks": [
            "@cs-check",
            "@phpunit",
            "@psalm",
            "@composer-require-checker",
            "@composer-unused"
        ]
    },
    "require": {
        "php": "^8.1",
        "symfony/event-dispatcher": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/translation-contracts": "^2.3|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/expression-language": "^6.4 || ^7.4 || ^8.0"
    },

    "suggest": {
        "symfony/translation": "To use translation capabilities",
        "symfony/expression-language": "To use dynamic values with expressions"
    },
    "autoload": {
        "psr-4": {
            "Kenny1911\\SymfonyHttpException\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kenny1911\\SymfonyHttpException\\Tests\\": "tests/"
        }
    }
}
